# Secrets and local runtime state
**/*credentials*
**/.credentials.yaml
**/*.pem
**/*.key
**/.env
**/.env.*
config/*local*
.codex/config.toml

# Codex runtime state (sessions, sqlite, logs, skills cache) — never deliverables
.codex/*.sqlite
.codex/*.sqlite-*
.codex/installation_id
.codex/logs_2.sqlite*
.codex/state_5.sqlite*
.codex/queue_1.sqlite*
.codex/thread_history_1.sqlite*
.codex/goals_1.sqlite*
.codex/memories_1.sqlite*
.codex/thread-writer-locks/
.codex/.sandbox_migration
.codex/.tmp/
.codex/skills/

# Local E2E artifacts and tooling state (never deliverables)
out/
private/
.v2c/

# Large/generated challenge artifacts
_logs/
_research/
_artifacts/
scratch/
**/__pycache__/
.pytest_cache/
*.pytest_cache
*.pyc
codex/codex-rs/target*/
*.zip
*.npy
*.npz
*.h5
*.h5ad
*.tar
*.tar.gz
*.tgz

# Harness runtime exports that must remain inert references
**/sessions/
**/attachments/
**/storages/
**/undo-snapshots/
.mimosa/
.video_agent/

# ZCode solve-session runtime state (user-created, never committed)
work/**/.submit-authorized
.ascodex/
.codex/tmp/
.codex/.sandbox-bin/
