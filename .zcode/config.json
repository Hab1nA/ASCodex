{
  "hooks": {
    "enabled": true,
    "events": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "enabled": true,
              "statusMessage": "ascodex 解题上下文检查...",
              "args": [
                "${ZCODE_PROJECT_DIR}/.zcode/hooks/solve-prompt-inject.js"
              ],
              "timeoutMs": 10000
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash|Write|Edit",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "enabled": true,
              "statusMessage": "ascodex 提交门检查...",
              "args": [
                "${ZCODE_PROJECT_DIR}/.zcode/hooks/submit-gate.js"
              ],
              "timeoutMs": 10000
            }
          ]
        }
      ]
    }
  }
}
